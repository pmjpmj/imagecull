# A config file for imagecull — a commented example.
#
# Copy this to `imagecull.toml` in your shoot folder, or to
# `~/.config/imagecull/config.toml` to apply it to every shoot, or pass it
# explicitly with `--config <FILE>`. Exactly one file is read: `--config` if
# given, else `./imagecull.toml`, else `$XDG_CONFIG_HOME/imagecull/config.toml`,
# else `~/.config/imagecull/config.toml`, else the built-in defaults. A file
# never layers over another one.
#
# A flag always beats the file; the file always beats the built-in default.
# Every key below is optional — leave one out and its default applies.
#
# Four sections, split by who reads them: `[score]` holds what a rating needs and
# `[group]` what a cull needs, while `[server]` and `[scan]` hold what both do.
# The `[preview]`, `[outputs]` and `[run]` sections of older files are gone: a
# file that still writes one is refused, naming the `[score]` key it became.
#
# Unknown keys are an error, not a warning: a typo'd `max_edeg` would otherwise
# cost you a whole run at the wrong resolution. Out-of-range values are errors
# too. Relative paths are resolved against this file's directory, so a config
# that travels with a shoot folder keeps working.
#
# What a config file cannot set, because it describes this invocation rather
# than this shoot: the shoot folder itself, `--dry-run`, `--force`,
# `--allow-foreign`, `--print-sidecars`, `--limit`, `--jobs`, `--out`,
# `--quiet`/`--verbose`.

[server]
# Base URL of the server this run talks to: a local oMLX by default, and any host
# speaking the same decision API when something else is named here. Default:
# http://127.0.0.1:8000
endpoint = "http://127.0.0.1:8000"
# The request path, as a template: `{model}` becomes the model id, verbatim and
# unencoded — a Workers AI id contains `/` and `@`, and encoding them would
# address something else. Default: /v1/systemone (oMLX's fixed path)
# path = "/v1/systemone"
# Model alias to ask. `score` defaults to the rubric's own alias; `groups`,
# `doctor` and `models` default to clef-flash-oQ4e when neither this nor
# `--model` is given. Changing the alias changes the rubric hash, and two runs
# with different hashes are not comparable.
# model = "clef-flash-oQ4e"
# What the request body's `model` field says, when the server wants a selector
# (`clef-flash` on Workers AI) rather than the model id. Default: the model,
# whole — which is what oMLX, Vultr and DeepInfra read.
# selector = "clef-flash"
# The environment variable a bearer token is read from, for a server that wants
# one. The variable wins over `token` below. Default: no token source, so no
# Authorization header is sent.
# token_env = "CLOUDFLARE_API_TOKEN"
# A literal bearer token, for a machine whose environment cannot hold one.
# Default: none — `token_env` is where a token belongs. A secret in a file that
# travels with a shoot folder is one `git add` away from being published; the
# variable is the default for a reason.
# token = "..."
# Whether the body carries oMLX's `truncate: true`. Workers AI's schema does not
# list the field, so a Workers AI config sets false and sends none. Default: true
# truncate = true
# Read timeout, in seconds. Default: 120
# timeout = 120

[scan]
# Also scan subdirectories, in `score` and in `groups` alike. Hidden
# directories are never scanned. Default: false (the shoot folder only)
# recursive = false

[score]
# What one rating needs: how much picture to send, where the raw answers go, and
# how the frame is judged. `score` reads all of it; `doctor <FILE>` reads the
# preview pair too, because its file check renders the preview a rating would
# send. `groups` borrows `shoot_context` and nothing else.
#
# Cap on the longest edge of the preview sent for one frame's rating, in pixels.
# Smaller is faster and cheaper in context; below ~1000 px fine detail stops
# being judgeable. A comparison has its own pair under `[group]`. Default: 1568
# max_edge = 1568
# JPEG quality of that preview, 1-100. Default: 88
# jpeg_quality = 88
#
# Every raw model answer, as JSON, so a surprising score loses nothing. It is
# `score`'s record, not `groups`, which writes its measures to `--out`.
# Default: not written
# json_scores = "scores.json"
#
# The rubric to judge by: a built-in's name, or a path to a rubric file.
# Default: general. Three rubrics are compiled in — `general`, which assumes no
# genre and is what runs when nothing else is selected; `press`, a photo editor
# culling a photojournalistic shoot; and `holiday`, which judges a frame as a
# family-album keeper. A bare name is always a built-in, so use `./holiday` for
# a file that happens to be called that. The rubric's hash is written into each
# sidecar, so a rating can always say which wording made it, and a re-run under a
# different rubric skips the frames already rated unless you pass --force.
# rubric = "holiday"
# A rubric of your own: a path, relative to this file's directory.
# rubric = "mine.toml"
# Free text about the shoot, passed to the model as state.shoot_context, so a
# dim, high-ISO street shoot is judged as that. `groups` passes it to the
# comparison too, since a dim, high-ISO burst deserves the same framing: the
# description belongs to the shoot, not to the pass, which is why a cull reads
# this one key from `[score]`.
# shoot_context = "night street, pushed two stops"
# Reuse the outcome of a frame whose preview is byte-identical to another.
# `score` only: a group's frames are different pictures of one moment, never
# duplicates. Default: true
# dedupe = true

[group]
# What counts as one moment, and how much picture a comparison sends. `groups`
# reads this section and `score` ignores it; changing a threshold changes the
# grouping hash, so verdicts computed under another value are not comparable.
#
# The most seconds between two frames of one group, measured from the previous
# frame rather than from the group's first. Default: 2.0
# gap = 2.0
# The least cosine similarity between a frame and its group's first frame: 1.0
# is the same scene and 0.0 is unrelated. Lower it to group a subject who moved
# a little; raise it to keep a pan in the compositions it actually produced.
# Default: 0.90
# similarity = 0.90
# The most brightness drift, in stops, between two frames of one group; `0`
# asks for one exposure exactly. Default: 2.0
# exposure_stops = 2.0

# What one image of a comparison carries. `groups` sends every frame of a group
# in one request, so this is per image and the measured default is small: a
# group's verdict was shown to be decisive at 512 px on a real sharp-against-soft
# difference, and twenty of them is a quarter of the model's token budget.
# Raising it sees more detail and costs more tokens per frame; a group that no
# longer fits is reported undecided (HTTP 413), never quietly shrunk.
# Default: 512
# max_edge = 512
# JPEG quality of one image in a comparison, 1-100. Default: 88
# jpeg_quality = 88

# How many groups the cull judges at once: the most comparative requests in
# flight together. It is a cap, not a target, and it is scheduling rather than
# algorithm, so it does not enter the grouping hash. Lower it to 1 when the
# server is shared and every group should wait its turn. `--cull-jobs` beats
# this key for one run. Default: 4
# cull_jobs = 4

# The most previews one comparative request carries: the batch a group is split
# into when it is larger than this. Valid 2-20 — one image is not a comparison,
# and 20 is the batch the token budget was measured at. Lower it for a server
# that refuses more per request (Workers AI takes 4). Like `cull_jobs` it is
# scheduling, not algorithm, so it does not enter the grouping hash either.
# Default: 20
# max_images = 20

# ---------------------------------------------------------------------------
# Rating a shoot with Cloudflare's hosted Clef (Workers AI)
#
# Requires an account id and an API token with Workers AI:Read. Export the token
# first — it is read from the environment, never from this file:
#
#     export CLOUDFLARE_API_TOKEN=...
#
# then copy the block below into your shoot's imagecull.toml, in place of the
# `[server]` keys above. The rest of this file — `[scan]`, the rating's other
# keys — is unchanged.
#
# recipe begins
# [server]
# endpoint = "https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/run"
# path = "/{model}"
# model = "@cf/cloudflare/clef-flash"
# selector = "clef-flash"
# token_env = "CLOUDFLARE_API_TOKEN"
# truncate = false
#
# [score]
# max_edge = 1024      # Workers AI resizes past ~1 MP, so 1568 buys nothing
#
# [group]
# max_images = 4       # Workers AI's per-request cap; a bigger burst is split
# recipe ends
#
# `score` and `groups` work against it as they do against oMLX. `doctor` and
# `models` do not: they read oMLX's own probes, and refuse this config by name
# rather than inventing a diagnosis they have no endpoint for.
# ---------------------------------------------------------------------------
