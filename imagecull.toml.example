# A config file for imagecull — a commented example.
#
# Copy this to `imagecull.toml` in your shoot folder, or to
# `~/.config/imagecull/config.toml` to apply it to every shoot, or pass it
# explicitly with `--config <FILE>`. Exactly one file is read: `--config` if
# given, else `./imagecull.toml`, else `$XDG_CONFIG_HOME/imagecull/config.toml`,
# else `~/.config/imagecull/config.toml`, else the built-in defaults. A file
# never layers over another one.
#
# A flag always beats the file; the file always beats the built-in default.
# Every key below is optional — leave one out and its default applies.
#
# Unknown keys are an error, not a warning: a typo'd `max_edeg` would otherwise
# cost you a whole run at the wrong resolution. Out-of-range values are errors
# too. Relative paths are resolved against this file's directory, so a config
# that travels with a shoot folder keeps working.
#
# What a config file cannot set, because it describes this invocation rather
# than this shoot: the shoot folder itself, `--dry-run`, `--force`,
# `--allow-foreign`, `--print-sidecars`, `--limit`, `--quiet`/`--verbose`.

[server]
# Base URL of the local oMLX server. Default: http://127.0.0.1:8000
endpoint = "http://127.0.0.1:8000"
# Model alias to score with. Default: the rubric's own alias.
# `doctor` and `models` default to clef-flash-oQ4e when neither this nor
# `--model` is given. Changing the alias changes the rubric hash, and two runs
# with different hashes are not comparable.
# model = "clef-flash-oQ4e"
# Read timeout, in seconds. Default: 120
# timeout = 120

[preview]
# Cap on the longest edge of the preview sent to the model, in pixels.
# Smaller is faster and cheaper in context; below ~1000 px fine detail stops
# being judgeable. Default: 1568
# max_edge = 1568
# JPEG quality of the sent preview, 1-100. Default: 88
# jpeg_quality = 88

[scan]
# Also scan subdirectories. Hidden directories are never scanned.
# Default: false (the shoot folder only)
# recursive = false

[outputs]
# Ratings do not come out of a report: a run writes each one into an XMP sidecar
# beside its frame (`DSC_0001.NEF` -> `DSC_0001.xmp`), where Lightroom, Bridge and
# darktable can read it. There is nothing to configure about that.
#
# Every raw model answer, as JSON, so a surprising score loses nothing.
# Default: not written
# json_scores = "scores.json"

[run]
# The rubric to judge by: a built-in's name, or a path to a rubric file.
# Default: general. Three rubrics are compiled in — `general`, which assumes no
# genre and is what runs when nothing else is selected; `press`, a photo editor
# culling a photojournalistic shoot; and `holiday`, which judges a frame as a
# family-album keeper. A bare name is always a built-in, so use `./holiday` for
# a file that happens to be called that. The rubric's hash is written into each
# sidecar, so a rating can always say which wording made it, and a re-run under a
# different rubric skips the frames already rated unless you pass --force.
# rubric = "holiday"
# A rubric of your own: a path, relative to this file's directory.
# rubric = "mine.toml"
# Free text about the shoot, passed to the model as state.shoot_context, so a
# dim, high-ISO street shoot is judged as that.
# shoot_context = "night street, pushed two stops"
# Reuse the outcome of a frame whose preview is byte-identical to another.
# Default: true
# dedupe = true
